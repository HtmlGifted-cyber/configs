#!/bin/bash
# tools - list your command-line tools (~/bin and ~/.local/bin), hiding backups and caches.
for d in ~/bin ~/.local/bin; do
  echo -e "\e[00;32m${d/#$HOME/~}\e[00m"
  find "$d" -maxdepth 1 \( -type f -o -type l \) -perm -u+x -printf '%f\n' 2>/dev/null | grep -v -e '\.bak' | sort | column -c "$(tput cols 2>/dev/null || echo 100)"
done
