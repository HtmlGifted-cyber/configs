#!/bin/bash

#This script is ran to get geological location
# data for a entered Ip address
#Htmlgifted

# https://github.com/HtmlGifted-cyber
#

#Sets the entered ip as a variable

#Asks for host info
echo please enter ip to scan.

#sets the entered host as variable
read varhost


#requests the website ip geo location for ip information
geoiplookup $varhost > ~/hackstack/geoipresults.txt

 
#reads file and displays it
cat ~/hackstack/geoipresults.txt
                            



