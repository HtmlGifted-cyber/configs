#!/bin/bash
# analystics - find other websites that share a Google Analytics / AdSense ID
# (or the IDs a domain uses), via the free HackerTarget API.
# Usage: analystics UA-123456  |  analystics example.com  |  analystics  (asks)
varhost="$1"
if [ -z "$varhost" ]; then
  echo 'Please enter a domain or an Analytics / AdSense ID. Example: UA-123456 or pub-123456'
  read -r varhost
fi
[ -z "$varhost" ] && exit 1
curl -s "https://api.hackertarget.com/analyticslookup/?q=$varhost"; echo
