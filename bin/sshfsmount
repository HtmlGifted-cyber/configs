#!/bin/bash
# sshfsmount - mount a folder from another computer over SSH (needs sshfs).
# Usage: sshfsmount user@host:/remote/folder ~/local/folder
#   or set defaults in ~/.bash_aliases.local:
#     export SSHFS_REMOTE="user@host:/home/user/"   SSHFS_MOUNT="$HOME/mnt/server"
# Unmount later with: fusermount -u <local folder>
remote="${1:-$SSHFS_REMOTE}"
mountpt="${2:-${SSHFS_MOUNT:-$HOME/mnt/remote}}"
if [ -z "$remote" ]; then
  read -rp "Remote folder (user@host:/path): " remote
  [ -z "$remote" ] && exit 1
fi
mkdir -p "$mountpt"
sshfs -o idmap=user "$remote" "$mountpt" && echo "Mounted $remote on $mountpt"
