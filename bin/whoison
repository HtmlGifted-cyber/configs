#!/bin/bash
# whoison - list the devices answering on your local network (/24).
# Results are saved to ~/hackstack/nmpresults.txt. Needs nmap.
# Only scan networks you own or have permission to test.

HS="$HOME/hackstack"; mkdir -p "$HS"
OUT="$HS/nmpresults.txt"

# Base address (first 3 octets) of this machine's main IP
BASE=$(hostname -I | awk '{print $1}' | awk -F '.' '{ print $1"."$2"."$3 }')
[ -z "$BASE" ] && { echo "No network address found - are you connected?"; exit 1; }

echo "Scanning $BASE.0-254 ..."
nmap -sn "$BASE.0-254" | awk '/Nmap scan report/ {print $NF}' | tr -d '()' > "$OUT"

echo "Here are the results of your scan:"
cat "$OUT"
echo "$(wc -l < "$OUT") devices answered."
echo "$USER, you can find these IPs in $OUT"
