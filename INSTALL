#!/bin/bash
# Install these configs into your home folder.
#   ./INSTALL          copy files (asks first)
#   ./INSTALL -f       copy files without asking
#   ./INSTALL --link   symlink files to this repo instead of copying, so edits
#                      on your machine land in the repo (then use `pushconfigs`)

cd "$(dirname "${BASH_SOURCE}")"
REPO="$PWD"
git pull --ff-only 2>/dev/null

FILES=".bashrc .bash_profile .bash_aliases .exports .gitconfig"

doCopy() {
  rsync --exclude ".git/" --exclude "INSTALL" --exclude "README.md" -av . ~
}

doLink() {
  local bk="$HOME/.configs-backup-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$bk" ~/bin ~/hackstack
  for f in $FILES; do
    [ -e ~/"$f" ] && [ ! -L ~/"$f" ] && cp -a ~/"$f" "$bk/"
    ln -sfn "$REPO/$f" ~/"$f"
  done
  for f in bin/* hackstack/*; do
    [ -e ~/"$f" ] && [ ! -L ~/"$f" ] && { mkdir -p "$bk/$(dirname "$f")"; cp -a ~/"$f" "$bk/$f"; }
    ln -sfn "$REPO/$f" ~/"$f"
  done
  grep -q CONFIGS_DIR ~/.bash_aliases.local 2>/dev/null || echo "export CONFIGS_DIR=\"$REPO\"" >> ~/.bash_aliases.local
  echo "Linked. Your old files were backed up to $bk"
}

case "$1" in
  --link|-l) doLink ;;
  --force|-f) doCopy ;;
  *) read -p "This may overwrite existing files in your home directory. Are you sure? (y/n) " -n 1; echo
     [[ $REPLY =~ ^[Yy]$ ]] && doCopy ;;
esac

source ~/.bash_profile
